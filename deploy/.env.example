# Скопируйте в deploy/.env и заполните. Файл deploy/.env в git не попадает.
DOMAIN=gaika.example.ru
# server: рабочий контур с базой; production: демо-контур как публичный адрес
GAIKA_MODE=server
POSTGRES_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
CLIENT_LINK_KEY=
APP_TIME_ZONE=Europe/Moscow
# log: код входа пишется в журнал сервера, пока нет SMS или Telegram
AUTH_CHANNEL=log
DEMO_ACCESS_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
AI_MODE=demo
SEO_INDEX=
