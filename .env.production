# Публикуемая демонстрация (то, что собирает Lovable по кнопке Publish).
#
# Контур demo выбран сознательно: состояние живёт во вкладке зрителя (ADR-004), поэтому
# показы не мешают друг другу, работает симулятор ответов поставщиков и кнопка сброса
# к эталонному набору. Сервер при этом остаётся: SSR, выгрузка в Excel и приём ошибок.
VITE_DATA_SOURCE=demo

# Секретов здесь нет и быть не должно. Ключ доступа задаётся переменной окружения хостинга
# DEMO_ACCESS_KEY, строка подключения к базе — DATABASE_URL (ADR-005). См. docs/RUNBOOK.md.
