# Рабочий контур: данные приходят серверными функциями поверх адаптера сервера (ADR-004).
# Сборка: bun run build --mode server
VITE_DATA_SOURCE=server

# Шлюз моделей (ADR-035). По умолчанию работает заглушка: ключей в репозитории нет и не будет.
# Живой разбор включается на сервере: AI_MODE=live и ключ провайдера в настройках хостинга.
AI_MODE=demo
